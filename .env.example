# Database
DATABASE_URL="postgresql://psp:psp_dev_password@localhost:5433/psp?schema=public"

# API
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Business rules
APPROVAL_THRESHOLD_IDR=5000000     # distribusi >= nilai ini wajib disetujui (A5)
MAX_DISTRIBUTION_LAYERS=10         # pagar rantai composable (A1)
OUTBOX_POLL_INTERVAL_MS=2000

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
